[0.373, "o", "\u001b[35m╭──────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[35m│\u001b[0m \u001b[1mSamyama · Generation-Augmented Knowledge (GAK)\u001b[0m                           \u001b[35m│\u001b[0m\r\n\u001b[35m│\u001b[0m When the graph doesn't know, the LLM writes the missing facts INTO it —  \u001b[35m│\u001b[0m\r\n\u001b[35m│\u001b[0m provenance-tagged, then answered deterministically. \u001b[2m(the inverse of RAG)\u001b[0m \u001b[35m│\u001b[0m\r\n\u001b[35m╰──────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[1.217, "o", "\r\n"]
[0.003, "o", "\u001b[92m──────────── \u001b[0m\u001b[1;36m1\u001b[0m\u001b[1;36m · Ask the graph: failure modes of an electric motor?\u001b[0m\u001b[92m ────────────\u001b[0m\r\n"]
[0.505, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33me:E\u001b[0m\u001b[33mquipment\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:HAS_FAILURE_MODE\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mfm\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m WHERE e.name CONTAINS \u001b[0m\r\n\u001b[33m\"electric motor\"\u001b[0m\u001b[33m RETURN fm\u001b[0m\r\n"]
[1.205, "o", "  \u001b[31m→ miss\u001b[0m: the chiller+AHU graph has \u001b[1mno electric motor\u001b[0m — \u001b[1;36m0\u001b[0m failure modes. The \r\nanswer isn't in the data.\r\n"]
[1.204, "o", "\r\n"]
[0.001, "o", "\u001b[92m──── \u001b[0m\u001b[1;36m2\u001b[0m\u001b[1;36m · GAK: the engine's LLM agent writes the missing knowledge as Cypher\u001b[0m\u001b[92m ────\u001b[0m\r\n"]
